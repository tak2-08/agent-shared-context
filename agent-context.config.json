{
  "$schema": "./docs/config.schema.json",
  "version": 1,
  "project": {
    "name": "my-project",
    "displayName": "My Project",
    "prefix": "mp",
    "description": "One-line description for README + package.json"
  },
  "contextRoot": "agent-context",
  "archiveDir": "archive",
  "privateMirror": null,
  "features": {
    "auth": {
      "label": "Auth",
      "files": [
        "src/auth/index.ts:1"
      ],
      "description": "JWT + session"
    },
    "api": {
      "label": "API",
      "files": [
        "src/routes/api.ts:1"
      ],
      "description": "REST handlers"
    },
    "ui": {
      "label": "UI",
      "files": [
        "src/components/App.tsx:1",
        "src/app/globals.css:1"
      ],
      "description": "Design tokens + chrome"
    }
  },
  "graph": {
    "edges": [
      [
        "auth",
        "api"
      ],
      [
        "api",
        "ui"
      ]
    ]
  },
  "types": [
    "note",
    "memo",
    "idea",
    "learning",
    "bug",
    "decision",
    "diary",
    "code-history",
    "todo",
    "issue",
    "work-history",
    "overall-flow",
    "handoff"
  ],
  "schema": {
    "required": [
      "id",
      "type",
      "title",
      "tags",
      "feature",
      "agent",
      "created",
      "updated",
      "status",
      "summary"
    ],
    "featureEnum": "auto",
    "idPattern": "^[a-z-]+-[0-9]{8}-[a-z0-9]{8}$",
    "maxSummary": 200,
    "maxPreview": 60
  },
  "storage": {
    "backend": "json",
    "softLimits": {
      "softLimitChars": 200000,
      "maxEntries": 1000,
      "archiveAfterDays": 90
    }
  },
  "lint": {
    "onIndexRegenerate": true,
    "forbidWriteOverwrite": true,
    "requiredKeywords": false
  },
  "agents": {
    "allow": [
      "claude",
      "codex",
      "opencode",
      "human",
      "system"
    ],
    "default": "system"
  },
  "i18n": {
    "locales": [
      "ko",
      "en"
    ],
    "defaultLocale": "en"
  },
  "compliance": {
    "law": false,
    "cssContract": false
  },
  "live": {
    "enabled": true,
    "sessions": {
      "registry": "agent-context/sessions/sessions.json",
      "inboxDir": "agent-context/sessions/inbox",
      "config": "agent-context/sessions/config.json",
      "inbound": "accept",
      "socketType": "file",
      "plainTextOnly": true,
      "rateLimit": 10,
      "dedupWindow": 5000,
      "maxInbox": 50,
      "maxHeld": 100,
      "isolatePeerMachines": false
    },
    "radio": {
      "threadsDir": "agent-context/radio/threads",
      "passiveAware": true,
      "backgroundTask": true,
      "noHarnessModification": true,
      "noExtraLLMCalls": true,
      "fivePhaseProtocol": true,
      "primitives": [
        "create_thread",
        "send_message",
        "wait_for_mention"
      ]
    }
  },
  "typesFluid": true,
  "hierarchy": {
    "levels": {
      "post-it": {
        "tokens": 15,
        "desc": "L1 cache — 한 줄, 즉시, 포스트잇",
        "example": "API endpoint moved to /v2"
      },
      "memo": {
        "tokens": 50,
        "desc": "HBM — 짧은 메모, 메모지",
        "example": "JWT race condition fix"
      },
      "diary": {
        "tokens": 200,
        "desc": "DRAM — 일지, 하루 흐름",
        "example": "2026-08-27 작업 일지"
      },
      "bookshelf": {
        "tokens": 1000,
        "desc": "SSD — 책장, feature별 집약",
        "example": "Auth feature 전체 흐름"
      },
      "library": {
        "tokens": 5000,
        "desc": "Cold — 도서관, 프로젝트 전체",
        "example": "전체 아키텍처 결정"
      }
    },
    "autoAssign": true,
    "searchOrder": [
      "post-it",
      "memo",
      "diary",
      "bookshelf",
      "library"
    ],
    "lightweightAI": "auto"
  },
  "search": {
    "lightweightAI": true,
    "model": "lite",
    "autoAssign": true,
    "tokenBudget": 2000,
    "hierarchical": true,
    "order": [
      "post-it",
      "memo",
      "diary",
      "bookshelf",
      "library"
    ],
    "synonyms": {
      "jwt": [
        "token"
      ],
      "token": [
        "jwt"
      ],
      "auth": [
        "authentication",
        "인증"
      ],
      "authentication": [
        "auth"
      ],
      "bug": [
        "issue",
        "버그"
      ],
      "issue": [
        "bug"
      ],
      "race": [
        "경쟁조건"
      ],
      "pagination": [
        "페이지네이션",
        "cursor"
      ]
    }
  }
}
