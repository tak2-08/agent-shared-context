{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-context frontmatter schema",
  "_path": "T2Editor/agent-context/schema.json",
  "description": "모든 *.md frontmatter가 따라야 할 스키마. id/type/title/tags/feature/agent/created/updated/status/summary는 필수.",
  "type": "object",
  "required": ["id", "type", "title", "tags", "feature", "agent", "created", "updated", "status", "summary"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z-]+-[0-9]{8}-[a-z0-9]{8}$",
      "description": "{type}-{YYYYMMDD}-{8hex}"
    },
    "type": {
      "type": "string",
      "enum": ["note", "memo", "idea", "diary", "code-history", "decision", "todo", "bug", "learning", "audit", "session"]
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 80,
      "description": "40자 내 권장, 검색 1순위"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9-]+$" },
      "minItems": 1,
      "maxItems": 8
    },
    "feature": {
      "type": "string",
      "enum": ["foundation", "visual-system", "toolbar", "modal", "editor-surface", "content", "ai", "plugin", "admin", "storage", "server", "global"],
      "description": "graph.json/features.json 키와 연결, 연관성 탐색용"
    },
    "scope": {
      "type": "string",
      "pattern": "^(global|page|custom:.+)$",
      "default": "global"
    },
    "agent": {
      "type": "string",
      "enum": ["claude", "codex", "opencode", "human", "system"]
    },
    "created": { "type": "string", "format": "date-time" },
    "updated": { "type": "string", "format": "date-time" },
    "status": {
      "type": "string",
      "enum": ["open", "doing", "done", "archived", "proposed", "adopted", "rejected", "superseded"]
    },
    "priority": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5,
      "description": "5=반드시 봐야 할 교훈, 1=참고"
    },
    "summary": {
      "type": "string",
      "maxLength": 200,
      "description": "index.json에 노출, 본문 없이도 판단 가능"
    },
    "preview": { "type": "string", "maxLength": 120 },
    "related": {
      "type": "array",
      "items": { "type": "string" },
      "description": "상대 경로, graph 탐색용"
    },
    "affects": {
      "type": "array",
      "items": { "type": "string" },
      "description": "영향 받는 feature 목록, graph.json과 동기화"
    },
    "cause": { "type": "string", "description": "learnings 전용: 원인" },
    "fix": { "type": "string", "description": "learnings/bugs 전용: 해결" },
    "lesson": { "type": "string", "description": "learnings 전용: 교훈 한 줄" },
    "repro": { "type": "string", "description": "bugs 전용: 재현 경로" },
    "keywords": {
      "type": "object",
      "properties": {
        "ko": { "type": "array", "items": { "type": "string" } },
        "en": { "type": "array", "items": { "type": "string" } },
        "ja": { "type": "array", "items": { "type": "string" } },
        "zh": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
